{
  "manifest_version": 3,
  "name": "MemeCheckShield badge",
  "version": "0.1.0",
  "description": "Shows the MemeCheckShield verdict for the token you are viewing on DexScreener, pump.fun and Photon. Read-only; no wallet access.",
  "icons": { "64": "icon64.png", "128": "icon128.png" },
  "permissions": [],
  "host_permissions": ["https://memecheck.pages.dev/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://dexscreener.com/*", "https://pump.fun/*", "https://photon-sol.tinyastro.io/*"],
    "js": ["content.js"], "run_at": "document_idle"
  }]
}
